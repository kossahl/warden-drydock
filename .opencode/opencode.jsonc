{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "drydock-orchestrator",
  "permission": {
    "external_directory": "ask",
    "bash": {
      "gh *": "ask",
      "git commit *": "ask",
      "git merge *": "ask",
      "git push *": "ask"
    }
  },
  "watcher": {
    "ignore": [".git/**", "node_modules/**", "web/dist/**"]
  }
}
