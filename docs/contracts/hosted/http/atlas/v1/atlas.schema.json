{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warden-drydock.invalid/contracts/hosted/http/atlas/v1/atlas.schema.json",
  "title": "Hosted Campaign Atlas HTTP contracts v1",
  "oneOf": [
    {"$ref":"#/$defs/campaign_collection"},
    {"$ref":"#/$defs/overview"},
    {"$ref":"#/$defs/record_library_query"},
    {"$ref":"#/$defs/record_library_result"},
    {"$ref":"#/$defs/record_detail"},
    {"$ref":"#/$defs/neighborhood_query"},
    {"$ref":"#/$defs/neighborhood"},
    {"$ref":"#/$defs/history_query"},
    {"$ref":"#/$defs/history_collection"},
    {"$ref":"#/$defs/workflow_summary"},
    {"$ref":"#/$defs/cursor_envelope"}
  ],
  "$defs": {
    "public_id":{"type":"string","minLength":3,"maxLength":80,"pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "domain_id":{"type":"string","minLength":1,"maxLength":80,"pattern":"^[a-z0-9][a-z0-9-]*$"},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "authority":{"enum":["preparation","canon","revealed"]},
    "revision":{"type":"object","additionalProperties":false,"required":["revision_id","ordinal","tree_digest"],"properties":{"revision_id":{"$ref":"#/$defs/public_id"},"ordinal":{"type":"integer","minimum":1},"tree_digest":{"$ref":"#/$defs/digest"}}},
    "binding":{"type":"object","additionalProperties":false,"required":["campaign_id","viewed_revision","head_revision"],"properties":{"campaign_id":{"$ref":"#/$defs/public_id"},"viewed_revision":{"$ref":"#/$defs/revision"},"head_revision":{"$ref":"#/$defs/revision"}}},
    "raw_status":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["classification","value"],"properties":{"classification":{"const":"known"},"value":{"enum":["idea","draft","review","canon","revealed","archived","accepted"]}}},
      {"type":"object","additionalProperties":false,"required":["classification","value"],"properties":{"classification":{"const":"missing"},"value":{"type":"null"}}},
      {"type":"object","additionalProperties":false,"required":["classification","value"],"properties":{"classification":{"const":"unknown"},"value":{"type":"string","minLength":1,"maxLength":80,"not":{"enum":["idea","draft","review","canon","revealed","archived","accepted"]}}}}
    ]},
    "record_summary":{"type":"object","additionalProperties":false,"required":["record_id","record_type","name","raw_status","authority","summary","content_digest"],"properties":{"record_id":{"$ref":"#/$defs/domain_id"},"record_type":{"$ref":"#/$defs/domain_id"},"name":{"type":"string","minLength":1,"maxLength":200},"raw_status":{"$ref":"#/$defs/raw_status"},"authority":{"$ref":"#/$defs/authority"},"summary":{"type":"string"},"content_digest":{"$ref":"#/$defs/digest"}}},
    "record_full":{"type":"object","additionalProperties":false,"required":["record_id","record_type","name","raw_status","authority","summary","content","content_digest"],"properties":{"record_id":{"$ref":"#/$defs/domain_id"},"record_type":{"$ref":"#/$defs/domain_id"},"name":{"type":"string","minLength":1,"maxLength":200},"raw_status":{"$ref":"#/$defs/raw_status"},"authority":{"$ref":"#/$defs/authority"},"summary":{"type":"string"},"content":{"type":"string","maxLength":1000000},"content_digest":{"$ref":"#/$defs/digest"}}},
    "facet":{"type":"object","additionalProperties":false,"required":["value","count"],"properties":{"value":{"type":"string","minLength":1,"maxLength":80},"count":{"type":"integer","minimum":0}}},
    "facets":{"type":"object","additionalProperties":false,"required":["record_types","authorities","statuses"],"properties":{"record_types":{"type":"array","items":{"$ref":"#/$defs/facet"}},"authorities":{"type":"array","items":{"$ref":"#/$defs/facet"}},"statuses":{"type":"array","items":{"$ref":"#/$defs/facet"}}}},
    "campaign_item":{"type":"object","additionalProperties":false,"required":["campaign_id","campaign_name","adapter_id","recovery_state","head_revision","projected_revision"],"properties":{"campaign_id":{"$ref":"#/$defs/public_id"},"campaign_name":{"type":"string","minLength":1,"maxLength":200},"adapter_id":{"const":"mothership"},"recovery_state":{"enum":["ready","rebuild_required","integrity_blocked"]},"head_revision":{"$ref":"#/$defs/revision"},"projected_revision":{"oneOf":[{"$ref":"#/$defs/revision"},{"type":"null"}]}}},
    "campaign_collection":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","campaigns"],"properties":{"contract_name":{"const":"atlas_campaign_collection"},"contract_version":{"const":1},"campaigns":{"type":"array","items":{"$ref":"#/$defs/campaign_item"}}}},
    "overview":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","binding","campaign_name","adapter_id","record_count","edge_occurrence_count","approved_revision_count","facets"],"properties":{"contract_name":{"const":"atlas_overview"},"contract_version":{"const":1},"binding":{"$ref":"#/$defs/binding"},"campaign_name":{"type":"string","minLength":1,"maxLength":200},"adapter_id":{"const":"mothership"},"record_count":{"type":"integer","minimum":0},"edge_occurrence_count":{"type":"integer","minimum":0},"approved_revision_count":{"type":"integer","minimum":1},"facets":{"$ref":"#/$defs/facets"}}},
    "filters":{"type":"object","additionalProperties":false,"required":["record_types","authorities","statuses"],"properties":{"record_types":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/domain_id"}},"authorities":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/authority"}},"statuses":{"type":"array","uniqueItems":true,"items":{"type":"string","enum":["idea","draft","review","canon","revealed","archived","accepted","missing","unknown"]}}}},
    "record_library_query":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","campaign_id","viewed_revision","query","filters","limit","cursor"],"properties":{"contract_name":{"const":"atlas_record_library_query"},"contract_version":{"const":1},"campaign_id":{"$ref":"#/$defs/public_id"},"viewed_revision":{"$ref":"#/$defs/revision"},"query":{"type":"string","maxLength":4000},"filters":{"$ref":"#/$defs/filters"},"limit":{"type":"integer","minimum":1,"maximum":100},"cursor":{"type":["string","null"],"maxLength":4096}}},
    "record_library_result":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","binding","normalized_query","filters","limit","sort","total","items","facets","next_cursor","previous_cursor"],"properties":{"contract_name":{"const":"atlas_record_library_result"},"contract_version":{"const":1},"binding":{"$ref":"#/$defs/binding"},"normalized_query":{"type":"string","maxLength":4000},"filters":{"$ref":"#/$defs/filters"},"limit":{"type":"integer","minimum":1,"maximum":100},"sort":{"const":"record_id"},"total":{"type":"integer","minimum":0},"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/record_summary"}},"facets":{"$ref":"#/$defs/facets"},"next_cursor":{"type":["string","null"],"maxLength":4096},"previous_cursor":{"type":["string","null"],"maxLength":4096}}},
    "record_detail":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","binding","record"],"properties":{"contract_name":{"const":"atlas_record_detail"},"contract_version":{"const":1},"binding":{"$ref":"#/$defs/binding"},"record":{"$ref":"#/$defs/record_full"}}},
    "edge":{"type":"object","additionalProperties":false,"required":["edge_id","occurrence_order","source_record_id","target_record_id","relationship","state","context"],"properties":{"edge_id":{"type":"string","pattern":"^edge_[a-f0-9]{64}$"},"occurrence_order":{"type":"integer","minimum":1},"source_record_id":{"$ref":"#/$defs/domain_id"},"target_record_id":{"$ref":"#/$defs/domain_id"},"relationship":{"$ref":"#/$defs/domain_id"},"state":{"$ref":"#/$defs/domain_id"},"context":{"type":"string","minLength":1,"maxLength":2000}}},
    "neighborhood_query":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","campaign_id","viewed_revision","focus_record_id","depth","limit","cursor"],"properties":{"contract_name":{"const":"atlas_depth_1_neighborhood_query"},"contract_version":{"const":1},"campaign_id":{"$ref":"#/$defs/public_id"},"viewed_revision":{"$ref":"#/$defs/revision"},"focus_record_id":{"$ref":"#/$defs/domain_id"},"depth":{"const":1},"limit":{"type":"integer","minimum":1,"maximum":100},"cursor":{"type":["string","null"],"maxLength":4096}}},
    "neighborhood":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","binding","depth","limit","sort","focus","neighbors","edges","total_edges","next_cursor","previous_cursor"],"properties":{"contract_name":{"const":"atlas_depth_1_neighborhood"},"contract_version":{"const":1},"binding":{"$ref":"#/$defs/binding"},"depth":{"const":1},"limit":{"type":"integer","minimum":1,"maximum":100},"sort":{"const":"source_occurrence_edge"},"focus":{"$ref":"#/$defs/record_summary"},"neighbors":{"type":"array","items":{"$ref":"#/$defs/record_summary"}},"edges":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/edge"}},"total_edges":{"type":"integer","minimum":0},"next_cursor":{"type":["string","null"],"maxLength":4096},"previous_cursor":{"type":["string","null"],"maxLength":4096}}},
    "history_change":{"type":"object","additionalProperties":false,"required":["record_id","change_kind","link_revision_id","before_content_digest","after_content_digest","before_status","after_status","from_authority","to_authority"],"properties":{"record_id":{"$ref":"#/$defs/domain_id"},"change_kind":{"enum":["added","removed","content_changed","metadata_changed","authority_transition"]},"link_revision_id":{"$ref":"#/$defs/public_id"},"before_content_digest":{"oneOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"after_content_digest":{"oneOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"before_status":{"oneOf":[{"$ref":"#/$defs/raw_status"},{"type":"null"}]},"after_status":{"oneOf":[{"$ref":"#/$defs/raw_status"},{"type":"null"}]},"from_authority":{"oneOf":[{"$ref":"#/$defs/authority"},{"type":"null"}]},"to_authority":{"oneOf":[{"$ref":"#/$defs/authority"},{"type":"null"}]}}},
    "history_entry":{"type":"object","additionalProperties":false,"required":["revision","parent_revision_id","change_digest","affected_records","changes","proposal_id","proposal_version"],"properties":{"revision":{"$ref":"#/$defs/revision"},"parent_revision_id":{"oneOf":[{"$ref":"#/$defs/public_id"},{"type":"null"}]},"change_digest":{"$ref":"#/$defs/digest"},"affected_records":{"type":"array","uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["record_id","link_revision_id"],"properties":{"record_id":{"$ref":"#/$defs/domain_id"},"link_revision_id":{"$ref":"#/$defs/public_id"}}}},"changes":{"type":"array","items":{"$ref":"#/$defs/history_change"}},"proposal_id":{"oneOf":[{"$ref":"#/$defs/public_id"},{"type":"null"}]},"proposal_version":{"type":["integer","null"],"minimum":1}}},
    "history_query":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","campaign_id","viewed_revision","subject_record_id","limit","cursor","direction"],"properties":{"contract_name":{"const":"atlas_approved_history_query"},"contract_version":{"const":1},"campaign_id":{"$ref":"#/$defs/public_id"},"viewed_revision":{"$ref":"#/$defs/revision"},"subject_record_id":{"oneOf":[{"$ref":"#/$defs/domain_id"},{"type":"null"}]},"limit":{"type":"integer","minimum":1,"maximum":100},"cursor":{"type":["string","null"],"maxLength":4096},"direction":{"enum":["forward","backward"]}}},
    "history_collection":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","binding","subject_record_id","limit","sort","direction","total","entries","next_cursor","previous_cursor"],"properties":{"contract_name":{"const":"atlas_approved_history_collection"},"contract_version":{"const":1},"binding":{"$ref":"#/$defs/binding"},"subject_record_id":{"oneOf":[{"$ref":"#/$defs/domain_id"},{"type":"null"}]},"limit":{"type":"integer","minimum":1,"maximum":100},"sort":{"const":"revision_ordinal"},"direction":{"enum":["forward","backward"]},"total":{"type":"integer","minimum":0},"entries":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/history_entry"}},"next_cursor":{"type":["string","null"],"maxLength":4096},"previous_cursor":{"type":["string","null"],"maxLength":4096}}},
    "workflow_summary":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","binding","draft_generation_count","proposal_counts","active_session"],"properties":{"contract_name":{"const":"atlas_workflow_summary"},"contract_version":{"const":1},"binding":{"$ref":"#/$defs/binding"},"draft_generation_count":{"type":"integer","minimum":0},"proposal_counts":{"type":"object","additionalProperties":false,"required":["draft","rejected","conflict","published","quarantined"],"properties":{"draft":{"type":"integer","minimum":0},"rejected":{"type":"integer","minimum":0},"conflict":{"type":"integer","minimum":0},"published":{"type":"integer","minimum":0},"quarantined":{"type":"integer","minimum":0}}},"active_session":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["session_id","base_revision","workflow_version","confirmed_table_fact_count","unresolved_question_count"],"properties":{"session_id":{"$ref":"#/$defs/public_id"},"base_revision":{"$ref":"#/$defs/revision"},"workflow_version":{"type":"integer","minimum":1},"confirmed_table_fact_count":{"type":"integer","minimum":0},"unresolved_question_count":{"type":"integer","minimum":0}}}]}}},
    "record_cursor_binding":{"type":"object","additionalProperties":false,"required":["kind","campaign_id","revision_id","tree_digest","normalized_query","record_types","authorities","statuses","limit","sort","direction","boundary_record_id"],"properties":{"kind":{"const":"record_library"},"campaign_id":{"$ref":"#/$defs/public_id"},"revision_id":{"$ref":"#/$defs/public_id"},"tree_digest":{"$ref":"#/$defs/digest"},"normalized_query":{"type":"string","maxLength":4000},"record_types":{"type":"array","items":{"$ref":"#/$defs/domain_id"}},"authorities":{"type":"array","items":{"$ref":"#/$defs/authority"}},"statuses":{"type":"array","items":{"type":"string"}},"limit":{"type":"integer","minimum":1,"maximum":100},"sort":{"const":"record_id"},"direction":{"enum":["forward","backward"]},"boundary_record_id":{"$ref":"#/$defs/domain_id"}}},
    "neighborhood_cursor_binding":{"type":"object","additionalProperties":false,"required":["kind","campaign_id","revision_id","tree_digest","focus_record_id","limit","sort","direction","boundary_edge_id"],"properties":{"kind":{"const":"depth_1_neighborhood"},"campaign_id":{"$ref":"#/$defs/public_id"},"revision_id":{"$ref":"#/$defs/public_id"},"tree_digest":{"$ref":"#/$defs/digest"},"focus_record_id":{"$ref":"#/$defs/domain_id"},"limit":{"type":"integer","minimum":1,"maximum":100},"sort":{"const":"source_occurrence_edge"},"direction":{"enum":["forward","backward"]},"boundary_edge_id":{"type":"string","pattern":"^edge_[a-f0-9]{64}$"}}},
    "history_cursor_binding":{"type":"object","additionalProperties":false,"required":["kind","campaign_id","revision_id","tree_digest","subject_record_id","limit","sort","direction","boundary_ordinal"],"properties":{"kind":{"const":"approved_history"},"campaign_id":{"$ref":"#/$defs/public_id"},"revision_id":{"$ref":"#/$defs/public_id"},"tree_digest":{"$ref":"#/$defs/digest"},"subject_record_id":{"oneOf":[{"$ref":"#/$defs/domain_id"},{"type":"null"}]},"limit":{"type":"integer","minimum":1,"maximum":100},"sort":{"const":"revision_ordinal"},"direction":{"enum":["forward","backward"]},"boundary_ordinal":{"type":"integer","minimum":1}}},
    "cursor_binding":{"oneOf":[{"$ref":"#/$defs/record_cursor_binding"},{"$ref":"#/$defs/neighborhood_cursor_binding"},{"$ref":"#/$defs/history_cursor_binding"}]},
    "cursor_envelope":{"type":"object","additionalProperties":false,"required":["contract_name","contract_version","binding","digest","encoding"],"properties":{"contract_name":{"const":"atlas_deterministic_cursor"},"contract_version":{"const":1},"binding":{"$ref":"#/$defs/cursor_binding"},"digest":{"$ref":"#/$defs/digest"},"encoding":{"const":"base64url_unpadded_canonical_json"}}}
  }
}
