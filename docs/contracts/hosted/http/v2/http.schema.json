{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warden-drydock.invalid/contracts/hosted/http/v2/http.schema.json",
  "title": "Warden Drydock local browser HTTP contracts v2",
  "oneOf": [
    {"$ref":"#/$defs/provider_readiness_response"},
    {"$ref":"#/$defs/provider_consent_request"},
    {"$ref":"#/$defs/campaign_create_request"},
    {"$ref":"#/$defs/campaign_revision_view"},
    {"$ref":"#/$defs/record_view"},
    {"$ref":"#/$defs/generation_start_request"},
    {"$ref":"#/$defs/generation_view"},
    {"$ref":"#/$defs/generation_event"},
    {"$ref":"#/$defs/proposal_create_request"},
    {"$ref":"#/$defs/proposal_correction_request"},
    {"$ref":"#/$defs/proposal_rejection_request"},
    {"$ref":"#/$defs/proposal_approval_request"},
    {"$ref":"#/$defs/proposal_view"},
    {"$ref":"#/$defs/proposal_approval_result"},
    {"$ref":"#/$defs/error_response"}
  ],
  "$defs": {
    "public_id": {"type":"string","minLength":3,"maxLength":80,"pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "safe_text": {"type":"string","maxLength":240,"pattern":"^[^\\r\\n\\\\/]*$"},
    "authority": {"enum":["preparation","table_fact","canon","revealed"]},
    "revision_authority": {"enum":["preparation","canon","revealed"]},
    "domain_id": {"type":"string","minLength":3,"maxLength":200,"pattern":"^[a-z0-9][a-z0-9-]*$"},
    "revision_ref": {
      "type":"object","additionalProperties":false,
      "required":["revision_id","ordinal","tree_digest","validation_status"],
      "properties":{"revision_id":{"$ref":"#/$defs/public_id"},"ordinal":{"type":"integer","minimum":1},"tree_digest":{"$ref":"#/$defs/digest"},"validation_status":{"const":"passed"}}
    },
    "operation_request": {
      "type":"object","additionalProperties":false,
      "required":["contract_name","contract_version","request_id","operation","idempotency_key","payload_digest","expected_revision","expected_workflow_version"],
      "properties":{
        "contract_name":{"const":"operation_request"},"contract_version":{"const":2},
        "request_id":{"$ref":"#/$defs/public_id"},
        "operation":{"enum":["campaign_create","proposal_correct","proposal_reject","proposal_approve","provider_consent"]},
        "idempotency_key":{"$ref":"#/$defs/public_id"},"payload_digest":{"$ref":"#/$defs/digest"},
        "expected_revision":{"oneOf":[{"$ref":"#/$defs/public_id"},{"type":"null"}]},
        "expected_workflow_version":{"oneOf":[{"type":"integer","minimum":1},{"type":"null"}]},
        "subject_id":{"$ref":"#/$defs/public_id"},"intent_digest":{"$ref":"#/$defs/digest"}
      }
    },
    "error": {
      "type":"object","additionalProperties":false,
      "required":["category","code","stage","request_id","retryable"],
      "properties":{
        "category":{"enum":["unsupported_contract_version","unsafe_binding","validation_finding","idempotency_digest_conflict","stale_revision","capability_rejected","provider_unavailable","provider_retryable_failure","provider_terminal_failure","stream_sequence_conflict","source_digest_conflict","snapshot_integrity_failure","snapshot_lineage_failure","publication_intent_failure","quarantine_failure","proposal_validation_failure","proposal_approval_conflict","service_unavailable","not_found"]},
        "code":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"stage":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},
        "request_id":{"$ref":"#/$defs/public_id"},"retryable":{"type":"boolean"}
      }
    },
    "error_response": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","error"],
      "properties":{"contract_name":{"const":"error_response"},"contract_version":{"const":2},"error":{"$ref":"#/$defs/error"}}
    },
    "provider_readiness_response": {
      "type":"object","additionalProperties":false,
      "required":["contract_name","contract_version","provider_configured","provider_available","consent_current","consent_identity_digest","ai_available"],
      "properties":{"contract_name":{"const":"provider_readiness_response"},"contract_version":{"const":2},"provider_configured":{"type":"boolean"},"provider_available":{"type":"boolean"},"consent_current":{"type":"boolean"},"consent_identity_digest":{"oneOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"ai_available":{"type":"boolean"}}
    },
    "provider_consent_request": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","operation_request","input"],
      "properties":{"contract_name":{"const":"provider_consent_request"},"contract_version":{"const":2},"operation_request":{"allOf":[{"$ref":"#/$defs/operation_request"},{"not":{"anyOf":[{"required":["subject_id"]},{"required":["intent_digest"]}]},"properties":{"operation":{"const":"provider_consent"},"expected_revision":{"type":"null"},"expected_workflow_version":{"type":"null"}}}]},"input":{"type":"object","additionalProperties":false,"required":["explicit","consent_identity_digest"],"properties":{"explicit":{"const":true},"consent_identity_digest":{"$ref":"#/$defs/digest"}}}}
    },
    "campaign_create_request": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","operation_request","input"],
      "properties":{"contract_name":{"const":"campaign_create_request"},"contract_version":{"const":2},"operation_request":{"allOf":[{"$ref":"#/$defs/operation_request"},{"not":{"anyOf":[{"required":["subject_id"]},{"required":["intent_digest"]}]},"properties":{"operation":{"const":"campaign_create"},"expected_revision":{"type":"null"},"expected_workflow_version":{"type":"null"}}}]},"input":{"type":"object","additionalProperties":false,"required":["campaign_id","campaign_name","adapter_id"],"properties":{"campaign_id":{"$ref":"#/$defs/public_id"},"campaign_name":{"type":"string","minLength":1,"maxLength":120},"adapter_id":{"const":"mothership"}}}}
    },
    "record_summary": {
      "type":"object","additionalProperties":false,"required":["record_id","record_type","name","authority"],
      "properties":{"record_id":{"$ref":"#/$defs/domain_id"},"record_type":{"$ref":"#/$defs/domain_id"},"name":{"type":"string","minLength":1,"maxLength":200},"authority":{"$ref":"#/$defs/revision_authority"}}
    },
    "campaign_revision_view": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","campaign_id","campaign_name","adapter_id","viewed_revision","head_revision","records"],
      "properties":{"contract_name":{"const":"campaign_revision_view"},"contract_version":{"const":2},"campaign_id":{"$ref":"#/$defs/public_id"},"campaign_name":{"type":"string","minLength":1,"maxLength":120},"adapter_id":{"const":"mothership"},"viewed_revision":{"$ref":"#/$defs/revision_ref"},"head_revision":{"$ref":"#/$defs/public_id"},"records":{"type":"array","items":{"$ref":"#/$defs/record_summary"}}}
    },
    "record_view": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","campaign_id","revision_id","record_id","record_type","name","authority","content"],
      "properties":{"contract_name":{"const":"record_view"},"contract_version":{"const":2},"campaign_id":{"$ref":"#/$defs/public_id"},"revision_id":{"$ref":"#/$defs/public_id"},"record_id":{"$ref":"#/$defs/domain_id"},"record_type":{"$ref":"#/$defs/domain_id"},"name":{"type":"string","minLength":1,"maxLength":200},"authority":{"$ref":"#/$defs/revision_authority"},"content":{"type":"string","minLength":1,"maxLength":100000}}
    },
    "generation_context": {
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["scope"],"properties":{"scope":{"const":"campaign"}}},
        {"type":"object","additionalProperties":false,"required":["scope","record_id","content_digest"],"properties":{"scope":{"const":"record"},"record_id":{"$ref":"#/$defs/domain_id"},"content_digest":{"$ref":"#/$defs/digest"}}}
      ]
    },
    "generation_start_request": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","generation_id","campaign_id","source_revision","action","prompt","context"],
      "properties":{"contract_name":{"const":"generation_start_request"},"contract_version":{"const":2},"generation_id":{"$ref":"#/$defs/public_id"},"campaign_id":{"$ref":"#/$defs/public_id"},"source_revision":{"$ref":"#/$defs/public_id"},"action":{"enum":["ask","check","generate"]},"prompt":{"type":"string","minLength":1,"maxLength":4000},"context":{"$ref":"#/$defs/generation_context"},"session_id":{"$ref":"#/$defs/public_id"}}
    },
    "source_view": {
      "type":"object","additionalProperties":false,"required":["source_id","authority","revision_id","order","excerpt","excerpt_digest"],
