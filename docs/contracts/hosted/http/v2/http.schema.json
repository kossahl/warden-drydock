    },
    "generation_view": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","generation_id","campaign_id","source_revision","action","context","session_id","draft_authority","status","sources","source_set_digest","last_sequence","terminal_content","terminal_content_digest"],
      "properties":{"contract_name":{"const":"generation_view"},"contract_version":{"const":2},"generation_id":{"$ref":"#/$defs/public_id"},"campaign_id":{"$ref":"#/$defs/public_id"},"source_revision":{"$ref":"#/$defs/public_id"},"action":{"enum":["ask","check","generate"]},"context":{"$ref":"#/$defs/generation_context"},"session_id":{"oneOf":[{"$ref":"#/$defs/public_id"},{"type":"null"}]},"draft_authority":{"const":"draft"},"status":{"enum":["pending","complete","failed","cancelled"]},"sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source_view"}},"source_set_digest":{"$ref":"#/$defs/digest"},"last_sequence":{"type":"integer","minimum":0},"terminal_content":{"type":["string","null"],"maxLength":100000},"terminal_content_digest":{"oneOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]}},
      "allOf":[{"if":{"properties":{"status":{"const":"complete"}}},"then":{"properties":{"terminal_content":{"type":"string","minLength":1},"terminal_content_digest":{"$ref":"#/$defs/digest"}}}},{"if":{"properties":{"status":{"const":"pending"}}},"then":{"properties":{"terminal_content":{"type":"null"},"terminal_content_digest":{"type":"null"}}}}]
    },
    "generation_event": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","generation_id","sequence","event_type","draft_fragment","retryable"],
      "properties":{"contract_name":{"const":"generation_event"},"contract_version":{"const":2},"generation_id":{"$ref":"#/$defs/public_id"},"sequence":{"type":"integer","minimum":1},"event_type":{"enum":["start","delta","usage","completion","failure","cancel"]},"draft_fragment":{"type":["string","null"],"maxLength":32000},"retryable":{"type":["boolean","null"]}}
    },
    "proposal_create_request": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","request_id","idempotency_key","payload_digest","generation_id","proposal_id","campaign_id","source_revision","base_revision","source_set_digest","terminal_draft_digest","subject_id"],
      "properties":{"contract_name":{"const":"proposal_create_request"},"contract_version":{"const":2},"request_id":{"$ref":"#/$defs/public_id"},"idempotency_key":{"$ref":"#/$defs/public_id"},"payload_digest":{"$ref":"#/$defs/digest"},"generation_id":{"$ref":"#/$defs/public_id"},"proposal_id":{"$ref":"#/$defs/public_id"},"campaign_id":{"$ref":"#/$defs/public_id"},"source_revision":{"$ref":"#/$defs/public_id"},"base_revision":{"$ref":"#/$defs/public_id"},"source_set_digest":{"$ref":"#/$defs/digest"},"terminal_draft_digest":{"$ref":"#/$defs/digest"},"subject_id":{"$ref":"#/$defs/domain_id"}}
    },
    "proposal_correction_request": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","operation_request","proposal_id","proposal_version","source_revision","base_revision","change_id","subject_id","after_content"],
      "properties":{"contract_name":{"const":"proposal_correction_request"},"contract_version":{"const":2},"operation_request":{"allOf":[{"$ref":"#/$defs/operation_request"},{"required":["subject_id"],"not":{"required":["intent_digest"]},"properties":{"operation":{"const":"proposal_correct"},"expected_revision":{"$ref":"#/$defs/public_id"},"expected_workflow_version":{"type":"null"}}}]},"proposal_id":{"$ref":"#/$defs/public_id"},"proposal_version":{"type":"integer","minimum":1},"source_revision":{"$ref":"#/$defs/public_id"},"base_revision":{"$ref":"#/$defs/public_id"},"change_id":{"$ref":"#/$defs/public_id"},"subject_id":{"$ref":"#/$defs/domain_id"},"after_content":{"type":"string","minLength":1,"maxLength":100000}}
    },
    "proposal_rejection_request": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","operation_request","proposal_id","proposal_version","source_revision","base_revision"],
      "properties":{"contract_name":{"const":"proposal_rejection_request"},"contract_version":{"const":2},"operation_request":{"allOf":[{"$ref":"#/$defs/operation_request"},{"required":["subject_id"],"not":{"required":["intent_digest"]},"properties":{"operation":{"const":"proposal_reject"},"expected_revision":{"$ref":"#/$defs/public_id"},"expected_workflow_version":{"type":"null"}}}]},"proposal_id":{"$ref":"#/$defs/public_id"},"proposal_version":{"type":"integer","minimum":1},"source_revision":{"$ref":"#/$defs/public_id"},"base_revision":{"$ref":"#/$defs/public_id"}}
    },
    "proposal_approval_request": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","operation_request","proposal_id","proposal_version","source_revision","base_revision","expected_campaign_head","diff_digest","proposal_payload_digest","warden_confirmed"],
      "properties":{"contract_name":{"const":"proposal_approval_request"},"contract_version":{"const":2},"operation_request":{"allOf":[{"$ref":"#/$defs/operation_request"},{"required":["subject_id","intent_digest"],"properties":{"operation":{"const":"proposal_approve"},"expected_revision":{"$ref":"#/$defs/public_id"},"expected_workflow_version":{"type":"null"}}}]},"proposal_id":{"$ref":"#/$defs/public_id"},"proposal_version":{"type":"integer","minimum":1},"source_revision":{"$ref":"#/$defs/public_id"},"base_revision":{"$ref":"#/$defs/public_id"},"expected_campaign_head":{"$ref":"#/$defs/public_id"},"diff_digest":{"$ref":"#/$defs/digest"},"proposal_payload_digest":{"$ref":"#/$defs/digest"},"warden_confirmed":{"const":true}}
    },
    "diff_change": {
      "type":"object","additionalProperties":false,"required":["change_id","subject_id","change_type","record_type","from_authority","to_authority","before_content","after_content","before_digest","after_digest"],
      "properties":{"change_id":{"$ref":"#/$defs/public_id"},"subject_id":{"$ref":"#/$defs/domain_id"},"change_type":{"const":"update"},"record_type":{"$ref":"#/$defs/domain_id"},"from_authority":{"$ref":"#/$defs/revision_authority"},"to_authority":{"$ref":"#/$defs/revision_authority"},"before_content":{"type":"string","minLength":1,"maxLength":100000},"after_content":{"type":"string","minLength":1,"maxLength":100000},"before_digest":{"$ref":"#/$defs/digest"},"after_digest":{"$ref":"#/$defs/digest"}}
    },
    "proposal_view": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","proposal_id","proposal_version","campaign_id","generation_id","source_revision","base_revision","source_set_digest","terminal_draft_digest","artifact_kind","status","exact_diff","diff_digest","proposal_payload_digest","validation_status","published_revision_id"],
      "properties":{"contract_name":{"const":"proposal_view"},"contract_version":{"const":2},"proposal_id":{"$ref":"#/$defs/public_id"},"proposal_version":{"type":"integer","minimum":1},"campaign_id":{"$ref":"#/$defs/public_id"},"generation_id":{"$ref":"#/$defs/public_id"},"source_revision":{"$ref":"#/$defs/public_id"},"base_revision":{"$ref":"#/$defs/public_id"},"source_set_digest":{"$ref":"#/$defs/digest"},"terminal_draft_digest":{"$ref":"#/$defs/digest"},"artifact_kind":{"const":"proposal"},"status":{"enum":["draft","rejected","conflict","published","quarantined"]},"exact_diff":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/diff_change"}},"diff_digest":{"$ref":"#/$defs/digest"},"proposal_payload_digest":{"$ref":"#/$defs/digest"},"validation_status":{"enum":["pending","passed","failed"]},"published_revision_id":{"oneOf":[{"$ref":"#/$defs/public_id"},{"type":"null"}]}}
    },
    "proposal_approval_result": {
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["contract_name","contract_version","proposal","outcome","published_revision","error","exact_replay"],"properties":{"contract_name":{"const":"proposal_approval_result"},"contract_version":{"const":2},"proposal":{"allOf":[{"$ref":"#/$defs/proposal_view"},{"properties":{"status":{"const":"published"},"validation_status":{"const":"passed"},"published_revision_id":{"$ref":"#/$defs/public_id"}}}]},"outcome":{"const":"published"},"published_revision":{"$ref":"#/$defs/revision_ref"},"error":{"type":"null"},"exact_replay":{"type":"boolean"}}},
        {"type":"object","additionalProperties":false,"required":["contract_name","contract_version","proposal","outcome","published_revision","error","exact_replay"],"properties":{"contract_name":{"const":"proposal_approval_result"},"contract_version":{"const":2},"proposal":{"allOf":[{"$ref":"#/$defs/proposal_view"},{"properties":{"status":{"const":"conflict"},"published_revision_id":{"type":"null"}}}]},"outcome":{"const":"conflict"},"published_revision":{"type":"null"},"error":{"allOf":[{"$ref":"#/$defs/error"},{"properties":{"category":{"const":"stale_revision"}}}]},"exact_replay":{"type":"boolean"}}}
      ]
    }
  }
}
