{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://warden-drydock.invalid/contracts/hosted/v1/engine.schema.json","title":"Deterministic engine command and staged result v1",
  "$defs":{"id":{"type":"string","minLength":3,"maxLength":80,"pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"finding":{"type":"object","required":["code","severity","stage","subject_id"],"additionalProperties":false,"properties":{"code":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"severity":{"enum":["info","warning","error"]},"stage":{"enum":["initialize","index","context","validate","stage"]},"subject_id":{"$ref":"#/$defs/id"}}}},
  "type":"object","required":["contract_name","contract_version","command_id","command","snapshot_handle","staged_handle","input_digest","status","findings"],"additionalProperties":false,
  "properties":{"contract_name":{"const":"engine_staged_result"},"contract_version":{"const":1},"command_id":{"$ref":"#/$defs/id"},"command":{"enum":["campaign_initialize","proposal_stage","artifacts_rebuild","campaign_validate"]},"snapshot_handle":{"$ref":"#/$defs/id"},"staged_handle":{"$ref":"#/$defs/id"},"input_digest":{"$ref":"#/$defs/digest"},"result_digest":{"$ref":"#/$defs/digest"},"status":{"enum":["staged","invalid","failed"]},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}}}
}
