{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://warden-drydock.invalid/contracts/hosted/v1/api.schema.json","title":"API envelope and operation contracts v1","x-invariants":["api_approval_binding","api_idempotency_binding"],
  "$defs":{
    "id":{"type":"string","minLength":3,"maxLength":80,"pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "safe":{"type":"string","maxLength":240,"pattern":"^[^\\r\\n\\\\/]*$"},
    "finding":{"type":"object","required":["code","severity","stage","subject_id"],"additionalProperties":false,"properties":{"code":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"severity":{"enum":["info","warning","error"]},"stage":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"subject_id":{"$ref":"#/$defs/id"},"message":{"$ref":"#/$defs/safe"}}},
    "error":{"type":"object","required":["category","code","stage","request_id"],"additionalProperties":false,"properties":{"category":{"enum":["unsupported_contract_version","unsafe_binding","validation_finding","idempotency_digest_conflict","stale_revision","stale_workflow_version","stale_controller_epoch","capability_rejected","provider_unavailable","provider_retryable_failure","provider_terminal_failure","stream_sequence_conflict","source_digest_conflict","snapshot_integrity_failure","snapshot_lineage_failure","publication_intent_failure","quarantine_failure","proposal_validation_failure","proposal_approval_conflict","service_unavailable"]},"code":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"stage":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"request_id":{"$ref":"#/$defs/id"},"message":{"$ref":"#/$defs/safe"},"retryable":{"type":"boolean"}}}
  },
  "type":"object","required":["contract_name","contract_version","request_id","operation","idempotency_key","payload_digest","expected_revision","expected_workflow_version"],"additionalProperties":false,
  "properties":{"contract_name":{"const":"operation_request"},"contract_version":{"const":1},"request_id":{"$ref":"#/$defs/id"},"operation":{"enum":["campaign_create","session_start","session_capture","session_end","proposal_correct","proposal_reject","proposal_approve","provider_configure","provider_consent","projection_rebuild","backup_create"]},"idempotency_key":{"$ref":"#/$defs/id"},"payload_digest":{"$ref":"#/$defs/digest"},"expected_revision":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"expected_workflow_version":{"oneOf":[{"type":"integer","minimum":1},{"type":"null"}]},"subject_id":{"$ref":"#/$defs/id"},"intent_digest":{"$ref":"#/$defs/digest"},"prior_receipt":{"oneOf":[{"type":"object","required":["idempotency_key","payload_digest","same_payload_digest","outcome"],"additionalProperties":false,"properties":{"idempotency_key":{"$ref":"#/$defs/id"},"payload_digest":{"$ref":"#/$defs/digest"},"same_payload_digest":{"const":true},"outcome":{"enum":["accepted","exact_replay"]}}},{"type":"object","required":["idempotency_key","payload_digest","same_payload_digest","outcome"],"additionalProperties":false,"properties":{"idempotency_key":{"$ref":"#/$defs/id"},"payload_digest":{"$ref":"#/$defs/digest"},"same_payload_digest":{"const":false},"outcome":{"const":"digest_conflict"}}}]},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},"error":{"$ref":"#/$defs/error"}}
}
