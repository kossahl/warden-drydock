{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://warden-drydock.invalid/contracts/hosted/v1/operations.schema.json","title":"Audit, receipt, reconciliation, backup, and health contracts v1","x-invariants":["operations_reconciliation"],
  "$defs":{"id":{"type":"string","minLength":3,"maxLength":80,"pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
