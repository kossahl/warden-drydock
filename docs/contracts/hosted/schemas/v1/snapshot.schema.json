{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://warden-drydock.invalid/contracts/hosted/v1/snapshot.schema.json","title":"Snapshot publication and rebuild contracts v1","x-invariants":["snapshot_lineage_quarantine"],
  "$defs":{"id":{"type":"string","minLength":3,"maxLength":80,"pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"file":{"type":"object","required":["relative_path","sha256"],"additionalProperties":false,"properties":{"relative_path":{"type":"string","minLength":1,"maxLength":240,"pattern":"^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},"sha256":{"$ref":"#/$defs/digest"}}}},
  "type":"object","required":["contract_name","contract_version","campaign_id","revision_id","parent_revision","ordinal","tree_digest","files","framework_version","adapter_version","validation_contract_digest","change_digest","publication_intent","head_expectation","lineage_status","projection_checkpoint","rebuild_result"],"additionalProperties":false,
  "properties":{"contract_name":{"const":"snapshot_manifest"},"contract_version":{"const":1},"campaign_id":{"$ref":"#/$defs/id"},"revision_id":{"$ref":"#/$defs/id"},"parent_revision":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"ordinal":{"type":"integer","minimum":1},"tree_digest":{"$ref":"#/$defs/digest"},"files":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/file"}},"framework_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"adapter_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"validation_contract_digest":{"$ref":"#/$defs/digest"},"change_digest":{"$ref":"#/$defs/digest"},"publication_intent":{"oneOf":[{"type":"object","required":["intent_id","intent_token","classification","matching_intent_count"],"additionalProperties":false,"properties":{"intent_id":{"$ref":"#/$defs/id"},"intent_token":{"$ref":"#/$defs/id"},"classification":{"enum":["persisted","matched"]},"matching_intent_count":{"const":1}}},{"type":"object","required":["classification","matching_intent_count"],"additionalProperties":false,"properties":{"intent_id":{"$ref":"#/$defs/id"},"intent_token":{"$ref":"#/$defs/id"},"classification":{"const":"quarantined"},"matching_intent_count":{"type":"integer","minimum":0}}}]},"head_expectation":{"type":"object","required":["expected_parent","expected_ordinal"],"additionalProperties":false,"properties":{"expected_parent":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"expected_ordinal":{"type":"integer","minimum":1}}},"lineage_status":{"enum":["verified_linear","quarantined"]},"quarantine":{"type":"object","required":["reason_code"],"additionalProperties":false,"properties":{"reason_code":{"enum":["missing_intent","ambiguous_intent","integrity_mismatch","lineage_conflict"]}}},"projection_checkpoint":{"type":"object","required":["revision_id","projection_digest","record_count"],"additionalProperties":false,"properties":{"revision_id":{"$ref":"#/$defs/id"},"projection_digest":{"$ref":"#/$defs/d