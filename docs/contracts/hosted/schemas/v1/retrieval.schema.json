{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://warden-drydock.invalid/contracts/hosted/v1/retrieval.schema.json","title":"Pinned deterministic retrieval source envelope v1","x-invariants":["retrieval_determinism"],
