{
  "adapter": "mothership",
  "adapter_version": "0.3.0",
  "validation": {
    "field_values": {
      "visibility": ["warden", "players", "shared"],
      "warden_only": ["true", "false"]
    },
    "forbidden_combinations": [
      {"visibility": "players", "warden_only": "true"}
    ]
  },
  "connections": {
    "syntax": "- `relationship` → [[target-id|Readable Name]] (`state`) — One concise sentence of context.",
    "states": ["current", "former", "planned", "possible", "disputed", "believed", "hidden", "confirmed", "inactive", "unknown", "active"],
    "relationships": {
      "affected-by": {}, "affects": {}, "advances": {}, "allied-with": {},
      "anticipates": {}, "applies-to": {}, "believes": {}, "caused-by": {},
      "carries": {}, "changed": {}, "changes": {}, "claims-about": {},
      "connected-to": {}, "concerns": {}, "contains": {}, "contradicted-by": {},
      "contradicts": {}, "controlled-by": {}, "controls": {}, "created-by": {},
      "creates": {}, "depicts": {}, "derived-from": {}, "driven-by": {},
      "employs": {}, "established": {}, "features": {}, "followed": {},
      "follows": {}, "found-at": {}, "held-by": {}, "identified": {},
      "intended-for": {}, "introduces": {}, "involves": {}, "knows-about": {},
      "leads-to": {}, "located-at": {}, "located-in": {}, "may-reveal": {},
      "may-trigger": {}, "mentions": {}, "occupied-by": {}, "opposed-by": {},
      "opposed-to": {}, "operated-by": {}, "originated-from": {}, "owned-by": {},
      "owns": {}, "part-of": {}, "performed-by": {}, "points-to": {},
      "prepares": {}, "preys-on": {}, "protects-secret": {}, "proposes-change-to": {},
      "responds-to": {}, "revealed": {}, "reveals": {}, "reviews": {},
      "seeks": {}, "site-of": {}, "source-of": {}, "starts-at": {},
      "supports": {}, "targets": {}, "threatened-by": {}, "threatens": {},
      "travelling-to": {}, "triggered": {}, "triggered-by": {}, "uses": {},
      "vulnerable-to": {}, "works-for": {}, "requires-update-to": {}
    }
  },
  "legacy_paths": [
    {"path": "06-factions", "canonical": "04-factions"},
    {"path": "05-characters/npcs", "canonical": "05-npcs"},
    {"path": "10-adventures", "canonical": "10-adventures/available", "direct_files_only": true}
  ],
  "entity_types": {
    "character": {
      "template": "templates/character.md",
      "destination": "02-players/characters/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "location": {
      "template": "templates/location.md", "destination": "03-world/locations/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "system": {
      "template": "templates/system.md", "destination": "03-world/systems/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "creature": {
      "template": "templates/creature.md", "destination": "06-creatures/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "ship": {
      "template": "templates/ship.md", "destination": "07-ships/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "item": {
      "template": "templates/item.md", "destination": "08-items/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "clue": {
      "template": "templates/clue.md", "destination": "09-mysteries/clues/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "false-belief": {
      "template": "templates/false-belief.md", "destination": "09-mysteries/false-beliefs/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "revelation": {
      "template": "templates/revelation.md", "destination": "09-mysteries/revelations/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "adventure": {
      "template": "templates/adventure.md",
      "destination": "10-adventures/available/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "clock": {
      "template": "templates/clock.md", "destination": "11-campaign-engine/clocks/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"], "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "consequence": {
      "template": "templates/consequence.md", "destination": "11-campaign-engine/consequences/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"], "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "faction-turn": {
      "template": "templates/faction-turn.md", "destination": "11-campaign-engine/faction-turns/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"], "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "random-table": {
      "template": "templates/random-table.md", "destination": "14-random-tables/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"], "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "faction": {
      "template": "templates/faction.md",
      "destination": "04-factions/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "npc": {
      "template": "templates/npc.md",
      "destination": "05-npcs/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "session": {
      "template": "templates/session-log.md",
      "destination": "12-sessions/logs/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "date", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "session-prep": {
      "template": "templates/session-prep.md",
      "destination": "12-sessions/preparation/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "date", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "debrief": {
      "template": "templates/debrief.md",
      "destination": "12-sessions/debriefs/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "date", "visibility", "warden_only"],
      "required_values": {"visibility": "warden", "warden_only": "true"}
    },
    "handout": {
      "template": "templates/handout.md",
      "destination": "13-handouts/{id}.md",
      "required_fields": ["id", "type", "status", "ownership", "name", "audience", "visibility", "warden_only"],
      "nonempty_fields": ["audience"],
      "required_values": {"visibility": "players", "warden_only": "false"},
      "forbidden_headings": ["Warden truth", "Secrets", "Secret", "Hidden objective", "Hidden objectives", "Unrevealed information"]
    }
  }
}
