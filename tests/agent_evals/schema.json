{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warden-drydock.local/schemas/agent-eval-v1.json",
  "title": "Warden Drydock Agent Evaluation",
  "oneOf": [
    {"$ref": "#/$defs/routingDataset"},
    {"$ref": "#/$defs/handoffDataset"},
    {"$ref": "#/$defs/benchmarkReport"}
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "agentName": {
      "type": "string",
      "enum": [
        "adapter_specialist",
        "agent_curator",
        "architect",
        "core_implementer",
        "docs_maintainer",
        "hosted_backend_implementer",
        "product_designer",
        "product_strategist",
        "reviewer",
        "test_engineer",
        "web_frontend_implementer"
      ]
    },
    "caseMetadata": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": ["synthetic", "sanitized_repository_example"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "notes": {"type": "string"}
      },
      "required": ["source"],
      "additionalProperties": false
    },
    "telemetryValue": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["measured", "estimated", "unavailable"]
        },
        "value": {"type": ["integer", "null"], "minimum": 0},
        "method": {"type": ["string", "null"]}
      },
      "required": ["status", "value", "method"],
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unavailable"}}},
          "then": {
            "properties": {
              "value": {"type": "null"},
              "method": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["measured", "estimated"]}
            }
          },
          "then": {
            "properties": {
              "value": {"type": "integer", "minimum": 0},
              "method": {"type": "string", "minLength": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "routingExpected": {
      "type": "object",
      "properties": {
        "delegation": {
          "type": "string",
          "enum": ["required", "optional", "forbidden"]
        },
        "valid_agents": {
          "type": "array",
          "items": {"$ref": "#/$defs/agentName"},
          "uniqueItems": true
        },
        "forbidden_agents": {
          "type": "array",
          "items": {"$ref": "#/$defs/agentName"},
          "uniqueItems": true
        },
        "sequence": {
          "type": ["array", "null"],
          "items": {"$ref": "#/$defs/agentName"},
          "minItems": 1
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "required": [
        "delegation",
        "valid_agents",
        "forbidden_agents",
        "sequence",
        "rationale"
      ],
      "additionalProperties": false
    },
    "routingCase": {
      "type": "object",
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "prompt": {"type": "string", "minLength": 1},
        "expected": {"$ref": "#/$defs/routingExpected"},
        "metadata": {"$ref": "#/$defs/caseMetadata"}
      },
      "required": ["case_id", "prompt", "expected", "metadata"],
      "additionalProperties": false
    },
    "routingDataset": {
      "type": "object",
      "properties": {
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "kind": {"const": "routing_cases"},
        "dataset_id": {"$ref": "#/$defs/id"},
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/routingCase"}
        }
      },
      "required": ["schema_version", "kind", "dataset_id", "cases"],
      "additionalProperties": false
    },
    "requiredConcept": {
      "type": "string",
      "enum": [
        "outcome",
        "decision",
        "evidence",
        "changed_files",
        "file_reference",
        "verification",
        "failure",
        "risk",
        "next_action",
        "severity",
        "reproduction",
        "alternatives",
        "affected_invariants",
        "non_goals",
        "open_decision",
        "generated_artifact_impact",
        "migration_follow_up"
      ]
    },
    "forbiddenContent": {
      "type": "string",
      "enum": [
        "raw_transcript",
        "secret",
        "campaign_canon",
        "invented_telemetry",
        "unsupported_success_claim"
      ]
    },
    "handoffExpected": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["complete", "incomplete"]
        },
        "required_concepts": {
          "type": "array",
          "items": {"$ref": "#/$defs/requiredConcept"},
          "uniqueItems": true
        },
        "forbidden_content": {
          "type": "array",
          "items": {"$ref": "#/$defs/forbiddenContent"},
          "uniqueItems": true
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "required": [
        "verdict",
        "required_concepts",
        "forbidden_content",
        "rationale"
      ],
      "additionalProperties": false
    },
    "handoffCase": {
      "type": "object",
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "agent": {"$ref": "#/$defs/agentName"},
        "scenario": {"type": "string", "minLength": 1},
        "handoff": {"type": "string"},
        "expected": {"$ref": "#/$defs/handoffExpected"},
        "metadata": {"$ref": "#/$defs/caseMetadata"}
      },
      "required": [
        "case_id",
        "agent",
        "scenario",
        "handoff",
        "expected",
        "metadata"
      ],
      "additionalProperties": false
    },
    "handoffDataset": {
      "type": "object",
      "properties": {
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "kind": {"const": "handoff_cases"},
        "dataset_id": {"$ref": "#/$defs/id"},
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/handoffCase"}
        }
      },
      "required": ["schema_version", "kind", "dataset_id", "cases"],
      "additionalProperties": false
    },
    "qualityResult": {
      "type": "string",
      "enum": ["pass", "fail", "not_applicable", "not_evaluated"]
    },
    "benchmarkRun": {
      "type": "object",
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1},
        "outcome": {
          "type": "string",
          "enum": ["pass", "fail", "blocked", "not_run"]
        },
        "quality": {
          "type": "object",
          "properties": {
            "routing": {"$ref": "#/$defs/qualityResult"},
            "handoff": {"$ref": "#/$defs/qualityResult"},
            "task": {"$ref": "#/$defs/qualityResult"}
          },
          "required": ["routing", "handoff", "task"],
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "input_tokens": {"$ref": "#/$defs/telemetryValue"},
            "output_tokens": {"$ref": "#/$defs/telemetryValue"},
            "duration_ms": {"$ref": "#/$defs/telemetryValue"},
            "correction_rounds": {"$ref": "#/$defs/telemetryValue"}
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "duration_ms",
            "correction_rounds"
          ],
          "additionalProperties": false
        },
        "notes": {"type": ["string", "null"]}
      },
      "required": [
        "case_id",
        "attempt",
        "outcome",
        "quality",
        "telemetry",
        "notes"
      ],
      "additionalProperties": false
    },
    "benchmarkReport": {
      "type": "object",
      "properties": {
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "kind": {"const": "benchmark_report"},
        "report_id": {"$ref": "#/$defs/id"},
        "dataset_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "environment": {
          "type": "object",
          "properties": {
            "model": {"type": ["string", "null"]},
            "reasoning_effort": {
              "type": ["string", "null"],
              "enum": ["low", "medium", "high", "xhigh", "max", "ultra", null]
            },
            "configuration_ref": {"type": "string", "minLength": 1},
            "recorded_at": {"type": "string", "format": "date-time"}
          },
          "required": [
            "model",
            "reasoning_effort",
            "configuration_ref",
            "recorded_at"
          ],
          "additionalProperties": false
        },
        "runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/benchmarkRun"}
        }
      },
      "required": [
        "schema_version",
        "kind",
        "report_id",
        "dataset_refs",
        "environment",
        "runs"
      ],
      "additionalProperties": false
    }
  }
}
